# The controller uses IRSA and watches the cluster endpoint supplied by Terraform.
serviceAccount:
  create: true
  name: ${serviceAccountName}
  annotations:
    eks.amazonaws.com/role-arn: ${roleArn}

replicas: 2

nodeSelector:
  workload: ${workload}

settings:
  clusterName: ${clusterName}
  clusterEndpoint: ${clusterEndpoint}
  eksControlPlane: true
  isolateVPC: false
  enableZonalShift: false

controller:
  resources:
    requests:
      cpu: "100m"
      memory: "128Mi"
    limits:
      cpu: "500m"
      memory: "512Mi"