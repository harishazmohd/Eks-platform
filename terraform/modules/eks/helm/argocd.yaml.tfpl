# This Application points ArgoCD at the version-controlled BankApp Helm chart.
apiVersion: argoproj.io/v1alpha1
kind: Application

metadata:
   name: ${name}
   namespace: ${argocdNamespace}

spec:
   project: ${projectName}
   source:
      repoURL: ${repoURL}
      targetRevision: ${targetRevision}
      path: ${path}
      helm:
        valueFiles:
         - "${valueFiles}"

   destination:
      server: ${server}
      namespace: ${namespace}
   syncPolicy:
      automated:
         prune: true
         selfHeal: true
      syncOptions:
         - CreateNamespace=true
